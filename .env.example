# Copy to .env.local and fill in values from your OWN Supabase project
# (Project settings > API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional. Public base URL used in emails (defaults to production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without it, registration still works but no confirmation email is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SERVER-ONLY and bypasses RLS. Leave empty for local development.
# Never prefix with NEXT_PUBLIC_ and never share it.
SUPABASE_SERVICE_ROLE_KEY=
